# ─────────────────────────────────────────────────────────────────────────────
# Pane al Pane · variabili d'ambiente
# Copia questo file in «.env.local» (in locale) oppure inserisci i valori
# nelle impostazioni del progetto su Vercel. Non condividere mai questi valori.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (database, accesso della redazione, immagini e PDF) ────────────
# Supabase → Project Settings → API (o «Data API» / «API Keys»).
# Se queste due righe restano vuote il sito parte in «modalità prova».
NEXT_PUBLIC_SUPABASE_URL=
# La chiave pubblica: «publishable key» (sb_publishable_…) oppure la vecchia «anon key».
# È pensata per stare nel browser: la sicurezza è garantita dalle regole del database.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Modalità prova (solo sul proprio computer, senza Supabase) ──────────────
# Password per entrare in /redazione quando Supabase non è configurato.
# Almeno 8 caratteri. Lasciala vuota in produzione.
LOCAL_ADMIN_PASSWORD=
